# ============================================================
#  GeoAI Talent Agent — container environment (EXAMPLE / PLACEHOLDERS)
#
#  Copy to .env.docker and fill in the real values from .env.local.
#  .env.docker is gitignored AND dockerignored — never commit it, and it never
#  enters an image layer; docker compose injects it at runtime.
#
#  FORMAT RULE — differs from .env.local:
#    every value must sit ALONE on its line. Do NOT write
#        SUPABASE_SERVICE_KEY=sb_secret_abc   # service_role key
#    Next.js/dotenv strips that trailing comment; Docker Compose's env_file
#    parser may not, and the key would arrive with "   # service_role key"
#    appended — failing auth in a way that looks like a bad key.
#    Put explanations on their own line, as done below.
#
#  Do not quote values either — Compose treats quotes as part of the string.
#
#  BUILD-TIME vs RUN-TIME — the three NEXT_PUBLIC_* values below are inlined
#  into the bundle by Next at BUILD time (server code included), so setting
#  them here has no effect on their own. They must ALSO go in `.env` at the
#  repo root, which is what Compose passes to the build. See DOCKER.md §1.
#  Everything else in this file is genuinely runtime.
# ============================================================

# ---- Site URL ------------------------------------------------
# BUILD-TIME — must match the value in .env; changing it requires a rebuild.
# MUST be the public host once deployed, not localhost. Every invitation,
# feedback and password-reset link in outgoing email is built from this — a
# localhost value sends trainers a link only this machine can open.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- LLM (Groq) ----------------------------------------------
# Groq decommissions models: an LLM route failing with `model_decommissioned`
# means updating these ids, not the code.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_FAST=llama-3.1-8b-instant
# PRIMARY key from console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-main
# BACKUP 1 — auto-used when the primary hits its rate limit
GROQ_API_KEY_2=your-groq-api-key-backup-1
# BACKUP 2
GROQ_API_KEY_3=your-groq-api-key-backup-2
# Optional
ANTHROPIC_API_KEY=
# none | local
EMBEDDINGS_PROVIDER=none
# Optional — Tavily / SerpApi, for flight-fare lookup
SEARCH_API_KEY=

# ---- Supabase ------------------------------------------------
# Supabase Dashboard → Project → Settings → API
# BUILD-TIME — must match .env
NEXT_PUBLIC_SUPABASE_URL=
# anon / public key. BUILD-TIME — must match .env
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — SERVER ONLY, never exposed to the browser. Runtime.
SUPABASE_SERVICE_KEY=

# ---- Registration domain -------------------------------------
# Domain-restricted registration (@moe.gov.my OR the admin allowlist)
ALLOWED_EMAIL_DOMAIN=moe.gov.my

# ---- Geocoding / routing -------------------------------------
GEOCODER_PROVIDER=nominatim
ROUTING_PROVIDER=osrm

# ---- Email ---------------------------------------------------
# Dispatch order: Resend key → SMTP → console-log dev fallback.
# Do NOT set RESEND_API_KEY without a Resend-verified EMAIL_FROM domain — a key
# with no verified sender makes every send fail 403 SILENTLY.
EMAIL_API_KEY=
RESEND_API_KEY=
# Sender address, e.g. GeoAI Talent Agent <noreply@yourdomain.com>
EMAIL_FROM=
# SMTP: port 587/STARTTLS. Some networks block outbound 465 — the container
# uses the host's network, so a blocked network stays blocked.
SMTP_HOST=
SMTP_PORT=587
# true = SSL/TLS (465), false = STARTTLS (587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- Phase 5: invitation settings ----------------------------
# Set to route ALL invitation email to one inbox during UAT; blank = each
# trainer's own address in the database.
TEST_INBOX_EMAIL=
# Accept/decline token validity, days
INVITE_EXPIRY_DAYS=7

# ---- Phase 9: post-workshop feedback -------------------------
# Long random string protecting POST /api/cron/feedback-requests.
# After deploying to a public host, mirror this value into Supabase:
#   ALTER DATABASE postgres SET app.settings.feedback_cron_url =
#     'https://<app-host>/api/cron/feedback-requests';
#   ALTER DATABASE postgres SET app.settings.feedback_cron_secret = '<this value>';
# pg_net cannot reach localhost, so the daily job cannot deliver until then.
CRON_SECRET=
# Feedback link validity: 14-day stated deadline + 3-day grace
FEEDBACK_TOKEN_EXPIRY_DAYS=17

# ---- Security ------------------------------------------------
# Long random string signing invitation/feedback tokens.
# Changing it invalidates every outstanding accept/decline and feedback link.
TOKEN_SIGNING_SECRET=

# ---- Travel cost config --------------------------------------
# Land rates; flight/boat fares are looked up at runtime.
RATE_ROAD_PER_KM_0_500=1.00
RATE_ROAD_PER_KM_OVER_500=0.90
RATE_ROUND_TRIP_MULTIPLIER=2
RATE_NIGHT_ALLOWANCE_MYR=0
